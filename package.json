{
	"name": "agglayer-bridge-hub",
	"version": "1.0.0",
	"private": true,
	"description": "Agglayer Bridge Hub API",
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "lerna run build && pnpm run typecheck",
		"build:api": "lerna run build --scope=bridge-hub-api",
		"build:consumer": "lerna run build --scope=bridge-hub-consumer",
		"build:autoclaim": "lerna run build --scope=bridge-hub-auto-claim",
		"dev": "lerna run dev --parallel",
		"start": "lerna run start --parallel",
		"test": "lerna run test",
		"clean": "lerna clean -y && rm -rf node_modules packages/*/dist packages/*/node_modules",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"style": "pnpm run format && pnpm run lint:fix",
		"style:check": "pnpm run format:check && pnpm run lint",
		"typecheck": "lerna exec --stream --bail -- \"tsc -b\"",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.0.0",
		"@commitlint/config-conventional": "^19.0.0",
		"@polygonlabs/apps-team-lint": "^2.1.0",
		"@tsconfig/node-ts": "^23.0.0",
		"@tsconfig/node24": "^24.0.0",
		"eslint": "^10.0.0",
		"husky": "^9.1.7",
		"lerna": "^8.0.0",
		"lint-staged": "^16.2.7",
		"prettier": "^3.6.2",
		"typescript": "^5"
	}
}
