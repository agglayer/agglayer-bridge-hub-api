# Stage 1: Build stage
FROM oven/bun:1.2-alpine AS builder
WORKDIR /app
COPY . .
RUN bun install --dev --no-cache
# Build commons first (required dependency for auto-claim)
RUN cd packages/commons && bun run build
# Then build auto-claim
RUN bun run build:autoclaim

# Stage 2: Runtime stage
FROM oven/bun:1.2-alpine
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
      adduser -S bunuser -u 1001

# Copy the auto-claim dist files
COPY --from=builder /app/packages/auto-claim/dist ./dist

# Copy node_modules first (includes symlinks)
COPY --from=builder /app/node_modules ./node_modules

# Copy the commons package to overwrite the symlink with actual files
COPY --from=builder /app/packages/commons/dist ./node_modules/@agglayer/bridge-hub-commons/dist
COPY --from=builder /app/packages/commons/package.json ./node_modules/@agglayer/bridge-hub-commons/package.json

USER bunuser
EXPOSE 3001
CMD ["bun", "run", "dist/index.js"]
