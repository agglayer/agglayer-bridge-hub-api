{
	"version": "independent",
	"npmClient": "bun",
	"command": {
		"exec": {
			"bail": false
		},
		"version": {
			"conventionalCommits": true,
			"createRelease": "github",
			"message": "chore(release): publish %s [skip ci]"
		},
		"publish": {
			"conventionalCommits": true,
			"message": "chore(release): publish %s [skip ci]"
		}
	},
	"packages": ["packages/*"]
}
