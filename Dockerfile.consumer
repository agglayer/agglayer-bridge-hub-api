# Use oven/bun:1.2-alpine image
FROM oven/bun:1.2-alpine

# Set the working directory for the app
WORKDIR /app

# Step 1: Copy the root package.json and bun.lockb (these are needed for the install)
COPY package.json ./package.json
COPY bun.lock ./bun.lock

# Step 2: Install all root-level dependencies
RUN bun install --dev --no-cache

# Step 3: Copy the commons package (which is a dependency for consumer) into the container
COPY packages/commons/package.json ./packages/commons/package.json
COPY packages/commons ./packages/commons

# Step 4: Install dependencies for the commons package
WORKDIR /app/packages/commons
RUN bun install --dev --no-cache

# Step 5: Build the commons package
RUN bun run build

# Step 6: Now copy the consumer package into the container
WORKDIR /app
COPY packages/consumer/package.json ./packages/consumer/package.json
COPY packages/consumer ./packages/consumer

# Step 7: Install dependencies for the consumer package
WORKDIR /app/packages/consumer
RUN bun install --dev --no-cache

# Step 8: Build the consumer package
RUN bun run build

# Step 9: Set the default command to run the consumer app
CMD ["bun", "dist/index.js"]
